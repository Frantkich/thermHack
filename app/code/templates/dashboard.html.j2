{% extends "components/base.html.j2" %}
{% block content %}
<div class="row">
    <!-- Controler -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header bg-success text-white">Thermostat</div>
            <div class="card-body text-center d-flex flex-column justify-content-center align-items-center">
                <h3>
                    <span id="therm_status_txt" class="fw-bold">fetching status...</span>
                    <span id="therm_status_ico"></span>
                </h3>
                <div class="d-grid gap-3 w-75 mt-4">
                    <button id="therm_status_btn" class="btn btn-lg"><i class="bi bi-hourglass-split"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Planning -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <span>Planning</span>
            </div>
            <div class="card-body p-0" style="overflow-y: auto;">
                <table id="planning" class="table table-striped table-hover mb-0 small">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>Date</th>
                            <th>Hour Start</th>
                            <th>Hour End</th>
                            <th>Edit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="planning_fetching_row">
                            <td colspan="5" class="text-center text-muted">fetching planning...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <dialog class="dialog" id="planning_edit_task">
        <div class="dialog-header">
            <h1 class="dialog-title" id="planning_edit_tasks_title">Dialog title</h1>
            <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
        </div>
        <div class="dialog-body">
            <form class="d-flex flex-column gap-3 p-3">
                <label for="planning_edit_tasks_start" class="form-label">Start thermostat</label>
                <input type="time" id="planning_edit_tasks_start" class="form-control" aria-label="Time picker" value="">
                <label for="planning_edit_tasks_stop" class="form-label">stop thermostat</label>
                <input type="time" id="planning_edit_tasks_stop" class="form-control" aria-label="Time picker" value="">
            </form>
        </div>
        <div class="dialog-footer">
            <button type="button" class="btn-solid theme-secondary" data-bs-dismiss="dialog">Close</button>
            <button type="button" id="planning_edit_tasks_save" class="btn-solid theme-primary">Save changes</button>
        </div>
    </dialog>

    <!-- Motor Log -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <span>Last logs</span>
            </div>
            <div class="card-body p-0" style="overflow-y: auto;">
                <table id="motor_logs" class="table table-striped table-hover mb-0 small">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>Statut</th>
                            <th>IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="motor_logs_fetching_row">
                            <td colspan="5" class="text-center text-muted">fetching last logs...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascript_import %}
<script type="module" src="{{ url_for('static', filename='js/dashboard.js' )}}"></script>
{% endblock %}