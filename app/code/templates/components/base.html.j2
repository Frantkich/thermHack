<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ThermHack</title>
    <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='images/favicon.ico') }}">
    <link href="{{ url_for('static', filename='libs/bootstrap.min.css' )}}" rel="stylesheet" integrity="sha256-Z4UIsZjZsbiHfjOPQZ/a2gACS+K8xjilOd1ySFYJURI=" crossorigin="anonymous">
    <link href="{{ url_for('static', filename='libs/bootstrap-icons.min.css' )}}" rel="stylesheet" integrity="sha256-ecmcGh4Ok3+AilgWVyi37QCADwLvXvz80Q3+cUZOZ10=" crossorigin="anonymous">
</head>

<body>
    {% for message in get_flashed_messages(with_categories=true) %}
    {% if message[0] == "warning" %}
    <div class="alert theme-warning">{{ message[1] }}</div>
    {% else %}
    <div class="alert theme-info">{{ message[1] }}</div>
    {% endif %}
    {% endfor %}
    <div class="container mt-5">
        {% block content %}{% endblock %}
    </div>
    {% block javascript_import %}{% endblock %}
    <script type="module" src="{{ url_for('static', filename='libs/bootstrap.bundle.min.js' )}}" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
</body>

</html>